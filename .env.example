# Read-only RPC endpoints. Use a reviewed dedicated endpoint for deployment.
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Keep a separate key per deployment environment. Never commit real values.
SEPOLIA_PRIVATE_KEY=
MAINNET_PRIVATE_KEY=
AVALANCHE_DEPLOYER_PRIVATE_KEY=

# Explorer verification. Snowtrace currently permits a placeholder, but this
# override is available if the provider/API policy changes.
ETHERSCAN_API_KEY=
SNOWTRACE_API_KEY=

# Optional fork holder override.
AVALANCHE_XEN_WHALE=

# Avalanche mainnet deployment locks. Copy the reviewed phrases from
# docs/avalanche-deployment-readiness.md only during the deployment ceremony.
AVALANCHE_DEPLOY_CONFIRM=
AVALANCHE_GENESIS_CONFIRM=
AVALANCHE_INIT_CONFIRM=
AVALANCHE_CONFIRMATIONS=3
